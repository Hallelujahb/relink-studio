# --- Python (backend) ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Backup and editor scratch files
*.bak
*.swp
*~

# Logs
*.log

# backend runtime data: keep the folders (via .gitkeep), ignore what lands in them
backend/data/*.sqlite3
backend/uploads/*
!backend/uploads/.gitkeep
!backend/data/.gitkeep

# --- Node / frontend (relink-studio) ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Env files: never commit secrets/config ---
.env
.env.*
!.env.example

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Editor ---
.vscode/
.idea/

# --- Bundled sample datasets not meant to be published ---
test-dataset/*.csv
*.pyc
backend/data/*.sqlite3*
node_modules/
relink.log
*.bak*
backend/data/*
# Generated files (added by tidy-repo.sh)
.relink_restart
backend/venv/
backend/data/
backend/uploads/
